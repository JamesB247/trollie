# Copy to .env for local overrides. Never commit real credentials.
TROLLIE_ENV=dev
TROLLIE_DATABASE_URL=postgresql+psycopg://trollie:trollie@localhost:5432/trollie
TROLLIE_WEBAUTHN_RP_ID=localhost
TROLLIE_WEBAUTHN_ORIGIN=http://localhost:8000
TROLLIE_ADDRESS_KEY_FILE=secrets/address_key
# Mandate fixture (DECISIONS.md A2): only honoured when TROLLIE_ENV=test.
TROLLIE_MANDATE_FIXTURE_ENABLED=false
